{
  "name": "addonova",
  "version": "1.0.6",
  "description": "Next-gen browser extension framework",
  "type": "module",
  "bin": {
    "addonova": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./defines": {
      "types": "./dist/core/defines.d.ts",
      "import": "./dist/core/defines.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "remove-item dist --recursive --force",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "guchho-test run",
    "test:watch": "guchho-test watch"
  },
  "keywords": [
    "browser-extension",
    "webextension",
    "build-tool",
    "typescript",
    "addonova"
  ],
  "author": "CodeHemu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/addonova/addonova.git"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "giget": "^3.3.1",
    "guchho": "1.0.9",
    "jiti": "^2.7.0"
  },
  "peerDependencies": {
    "@addonova/browser": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@addonova/browser": {
      "optional": true
    }
  },
  "allowScripts": {
    "guchho@1.0.9": true
  },
  "devDependencies": {
    "@guchho/test": "^0.0.2",
    "@types/node": "^26.6.6",
    "remove-item": "^1.0.3",
    "typescript": "^7.0.2"
  }
}
